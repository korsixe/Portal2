{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "title": "Portal — Overview",
  "tags": ["portal", "spring-boot"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "type": "stat",
      "title": "Uptime (s)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "id": 1,
      "targets": [{"expr": "process_uptime_seconds{application=\"portal\"}", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "type": "stat",
      "title": "JVM memory used (MB)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "id": 2,
      "targets": [{"expr": "sum(jvm_memory_used_bytes{application=\"portal\"}) / 1024 / 1024", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "type": "timeseries",
      "title": "HTTP requests / sec",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"portal\"}[1m])) by (uri, status)",
          "legendFormat": "{{uri}} ({{status}})",
          "refId": "A"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "type": "timeseries",
      "title": "HTTP latency p95 (s)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"portal\"}[5m])) by (le, uri))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "type": "timeseries",
      "title": "JVM threads",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "id": 5,
      "targets": [{"expr": "jvm_threads_live_threads{application=\"portal\"}", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "type": "timeseries",
      "title": "DB connections (HikariCP)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "id": 6,
      "targets": [
        {"expr": "hikaricp_connections_active{application=\"portal\"}", "legendFormat": "active", "refId": "A"},
        {"expr": "hikaricp_connections_idle{application=\"portal\"}", "legendFormat": "idle", "refId": "B"}
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    }
  ]
}
